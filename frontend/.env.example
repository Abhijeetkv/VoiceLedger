# ========================================================
# VoiceLedger Frontend - Environment Configuration
# ========================================================

# Deployed Backend API URL (e.g. https://your-backend.vercel.app)
# - In local development: leave this empty so Vite automatically proxies /api to http://localhost:5000
# - On Vercel: set this in your Vercel Project Settings -> Environment Variables to your deployed backend URL
VITE_API_URL=

